<Window x:Class="Dusty_Jukebox.GuitarBud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuitarBud" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- 🎸 Fretboard Area -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <UniformGrid x:Name="FretboardGrid" Rows="6" Columns="22" />
        </ScrollViewer>

        <!-- 🎼 Side Panel for Melody / Chords / Rhythm -->
        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="Scale: A Minor" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Tuning:" />
            <ComboBox x:Name="TuningSelector" Margin="0,0,0,10">
                <ComboBoxItem Content="Standard (EADGBE)" IsSelected="True" />
                <ComboBoxItem Content="Drop D (DADGBE)" />
                <ComboBoxItem Content="D Standard (DGCFAD)" />
                <ComboBoxItem Content="C Standard (CFBbEbGC)" />
            </ComboBox>

            <TextBlock Text="Notes to Play (Melody):" />
            <TextBox x:Name="MelodyTextBox" Margin="0,0,0,10" Height="60" AcceptsReturn="True" />

            <TextBlock Text="Chords to Play (Harmony):" />
            <TextBox x:Name="ChordTextBox" Margin="0,0,0,10" Height="60" AcceptsReturn="True" />

            <TextBlock Text="Time Signature:" />
            <ComboBox x:Name="TimeSignatureComboBox" SelectedIndex="0" Margin="0,0,0,10">
                <ComboBoxItem Content="4/4" />
                <ComboBoxItem Content="3/4" />
                <ComboBoxItem Content="6/8" />
            </ComboBox>

            <Button x:Name="PlayMelodyButton" Content="🎵 Play Melody" Margin="0,10,0,5" Click="PlayMelodyButton_Click" />
            <Button x:Name="AutoComposeButton" Content="✨ Auto Compose" Click="AutoComposeButton_Click" />
            <Button x:Name="RefreshFretboardButton" Content="🔁 Refresh" Margin="0,20,0,0" Click="RefreshFretboardButton_Click" />
        </StackPanel>
    </Grid>
</Window>
